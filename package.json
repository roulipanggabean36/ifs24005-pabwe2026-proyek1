{
  "name": "ifs24005-pabwe2026-proyek1",
  "version": "1.0.0",
  "description": "Skincare Routine & Inventory Tracker - backend (Express.js + SQLite) dan frontend (Vue.js)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "node --watch backend/server.js",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
